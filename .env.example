# Telegram: create a NEW bot with @BotFather. Do not reuse the FinXray alert
# bot's token: two processes cannot long-poll the same bot.
GQ_BOT_TELEGRAM_TOKEN=

# GQ FinXray US Supabase project (users, watchlists, alerts, ETF tables).
SUPABASE_URL=
SUPABASE_KEY=

# Heatmap dashboard Supabase project (instruments, returns_latest,
# price_history, us_stock_fundamentals). Leave blank if it is the same project.
HEATMAP_SUPABASE_URL=
HEATMAP_SUPABASE_KEY=

# The bot's OWN Supabase project (new, empty). Only the question log lives here;
# FinXray and the heatmap above are read-only. Leave blank to turn logging off.
BOT_SUPABASE_URL=
BOT_SUPABASE_KEY=

# LLM. provider: openai (any OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
# Defaults: google/gemini-2.5-flash (openai) or claude-haiku-5-5 (anthropic)
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# Limits
GQ_BOT_MAX_TOOL_STEPS=6
GQ_BOT_HISTORY_TURNS=6
GQ_BOT_HISTORY_TTL_S=1800
GQ_BOT_PER_MINUTE=6
GQ_BOT_PER_DAY=150
GQ_BOT_LOG_QUERIES=true
